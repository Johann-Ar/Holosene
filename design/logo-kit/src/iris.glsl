// Masque d'anneau anticrénelé : r = length(p), Ro = rayon extérieur.
float irisRing(vec2 p, float Ro){
  float r = length(p), Ri = Ro * 0.514, aa = fwidth(r);
  return smoothstep(Ro + aa*0.5, Ro - aa*0.5, r) * smoothstep(Ri - aa*0.5, Ri + aa*0.5, r);
}
